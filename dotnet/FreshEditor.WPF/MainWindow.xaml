<Window x:Class="FreshEditor.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:ctrl="clr-namespace:FreshEditor.WPF.Controls"
        xmlns:vp="clr-namespace:FreshEditor.WPF.Viewport"
        Title="Fresh Voxel Editor" Height="900" Width="1600"
        WindowState="Maximized"
        Background="#FF1E1E1E" Foreground="#FFD4D4D4"
        Closing="Window_Closing">

  <Window.Resources>
    <!-- Dark button style -->
    <Style TargetType="Button" x:Key="DarkButton">
      <Setter Property="Background" Value="#FF3F3F46"/>
      <Setter Property="Foreground" Value="#FFD4D4D4"/>
      <Setter Property="BorderBrush" Value="#FF555558"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="Margin" Value="2,0"/>
    </Style>
  </Window.Resources>

  <DockPanel LastChildFill="True">

    <!-- ======================================================================
         MENU BAR
         ====================================================================== -->
    <Menu DockPanel.Dock="Top" Background="#FF2D2D30" Foreground="#FFD4D4D4">
      <MenuItem Header="_File" Foreground="#FFD4D4D4">
        <MenuItem Header="New Scene"   Click="NewScene_Click"/>
        <MenuItem Header="Open Scene…" Click="OpenScene_Click"/>
        <MenuItem Header="Save Scene"  Click="SaveScene_Click" InputGestureText="Ctrl+S"/>
        <Separator/>
        <MenuItem Header="Exit"        Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit" Foreground="#FFD4D4D4">
        <MenuItem Header="Undo"   Click="Undo_Click"  InputGestureText="Ctrl+Z"/>
        <MenuItem Header="Redo"   Click="Redo_Click"  InputGestureText="Ctrl+Y"/>
      </MenuItem>
      <MenuItem Header="_World" Foreground="#FFD4D4D4">
        <MenuItem Header="Import .vox…" Click="ImportVox_Click"/>
        <MenuItem Header="Export Region to .vox…" Click="ExportVox_Click"/>
      </MenuItem>
      <MenuItem Header="_Build" Foreground="#FFD4D4D4">
        <MenuItem Header="Build All" Click="BuildAll_Click"/>
      </MenuItem>
      <MenuItem Header="_Help" Foreground="#FFD4D4D4">
        <MenuItem Header="About Fresh Voxel Engine" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <!-- ======================================================================
         TOOLBAR
         ====================================================================== -->
    <ToolBar DockPanel.Dock="Top" Background="#FF2D2D30" Padding="4,2">
      <!-- File actions -->
      <Button Style="{StaticResource DarkButton}" Content="📂 Open"  Click="OpenScene_Click" ToolTip="Open Scene"/>
      <Button Style="{StaticResource DarkButton}" Content="💾 Save"  Click="SaveScene_Click" ToolTip="Save Scene"/>
      <Separator Background="#FF555558"/>
      <!-- Play / Stop -->
      <Button x:Name="PlayButton"
              Style="{StaticResource DarkButton}"
              Content="▶ Play" Background="#FF007A2F" Foreground="White"
              Click="Play_Click" ToolTip="Enter Play Mode"/>
      <Button x:Name="StopButton"
              Style="{StaticResource DarkButton}"
              Content="⬛ Stop" Background="#FF8B0000" Foreground="White"
              Click="Stop_Click" ToolTip="Stop Play Mode"
              IsEnabled="False"/>
      <Separator Background="#FF555558"/>
      <!-- Gizmo mode -->
      <Button Style="{StaticResource DarkButton}" Content="W" Click="GizmoTranslate_Click" ToolTip="Translate (W)"/>
      <Button Style="{StaticResource DarkButton}" Content="E" Click="GizmoRotate_Click"    ToolTip="Rotate (E)"/>
      <Button Style="{StaticResource DarkButton}" Content="R" Click="GizmoScale_Click"     ToolTip="Scale (R)"/>
      <Separator Background="#FF555558"/>
      <!-- Cell shading toggle -->
      <CheckBox x:Name="CellShadingToggle"
                Foreground="#FFD4D4D4" VerticalAlignment="Center" Margin="4,0"
                Content="Cell Shading"
                Checked="CellShading_Changed" Unchecked="CellShading_Changed"
                ToolTip="Toggle Borderlands-style cell shading"/>
    </ToolBar>

    <!-- ======================================================================
         STATUS BAR
         ====================================================================== -->
    <StatusBar DockPanel.Dock="Bottom" Background="#FF007ACC" Foreground="White">
      <StatusBarItem>
        <TextBlock x:Name="StatusLabel" Text="Ready"/>
      </StatusBarItem>
      <Separator Background="#FF005A9E"/>
      <StatusBarItem>
        <TextBlock x:Name="CoordLabel" Text="X: 0  Y: 0  Z: 0"/>
      </StatusBarItem>
    </StatusBar>

    <!-- ======================================================================
         MAIN CONTENT — AvalonDock docking manager
         ====================================================================== -->
    <ad:DockingManager x:Name="DockManager" Background="#FF252526">
      <ad:LayoutRoot>
        <ad:LayoutPanel Orientation="Vertical">

          <!-- Top row: Place Panel | Viewport | Scene Outliner + Details -->
          <ad:LayoutPanel Orientation="Horizontal" DockHeight="600">

            <!-- Place Panel (left) -->
            <ad:LayoutAnchorablePane DockWidth="220">
              <ad:LayoutAnchorable Title="Place" CanClose="False" CanHide="False">
                <Border Background="#FF252526" Padding="4">
                  <StackPanel>
                    <TextBlock Text="▸ Basic Shapes" Foreground="#FFD4D4D4" Margin="0,4,0,2"/>
                    <Button Style="{StaticResource DarkButton}" Content="🔵 Point Light" Margin="2,2"/>
                    <Button Style="{StaticResource DarkButton}" Content="☀ Directional Light" Margin="2,2"/>
                    <TextBlock Text="▸ Voxel Structures" Foreground="#FFD4D4D4" Margin="0,8,0,2"/>
                    <Button Style="{StaticResource DarkButton}" Content="🧊 Import .vox…" Margin="2,2" Click="ImportVox_Click"/>
                    <TextBlock Text="▸ Volumes" Foreground="#FFD4D4D4" Margin="0,8,0,2"/>
                    <Button Style="{StaticResource DarkButton}" Content="🌫 Fog Volume" Margin="2,2"/>
                    <Button Style="{StaticResource DarkButton}" Content="💧 Water Volume" Margin="2,2"/>
                  </StackPanel>
                </Border>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>

            <!-- Centre: 3-D Viewport -->
            <ad:LayoutDocumentPane>
              <ad:LayoutDocument Title="Viewport" CanClose="False">
                <Grid>
                  <!-- The HwndHost viewport (engine renders here via DX11) -->
                  <vp:ViewportHost x:Name="ViewportHost"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"/>
                  <!-- Gizmo / camera-speed overlay -->
                  <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"
                              Orientation="Horizontal" Margin="8" IsHitTestVisible="False">
                    <TextBlock x:Name="ViewportModeLabel" Text="EDITOR"
                               Background="#88000000" Foreground="#FFAEEBFF"
                               Padding="6,2" FontSize="10" FontWeight="Bold"/>
                  </StackPanel>
                </Grid>
              </ad:LayoutDocument>
            </ad:LayoutDocumentPane>

            <!-- Right panel group: Scene Outliner + Details stacked vertically -->
            <ad:LayoutAnchorablePane DockWidth="280">
              <ad:LayoutAnchorable Title="Scene Outliner" CanClose="False" CanHide="False">
                <ctrl:SceneOutlinerControl x:Name="SceneOutliner"/>
              </ad:LayoutAnchorable>
              <ad:LayoutAnchorable Title="Details" CanClose="False" CanHide="False">
                <ctrl:DetailsControl x:Name="DetailsPanel"/>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
          </ad:LayoutPanel>

          <!-- Bottom row: Content Browser | Output Log -->
          <ad:LayoutPanel Orientation="Horizontal" DockHeight="200">
            <ad:LayoutAnchorablePane DockWidth="600">
              <ad:LayoutAnchorable Title="Content Browser" CanClose="False" CanHide="False">
                <ctrl:ContentBrowserControl x:Name="ContentBrowser"/>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
            <ad:LayoutAnchorablePane>
              <ad:LayoutAnchorable Title="Output Log" CanClose="False" CanHide="False">
                <ctrl:OutputLogControl x:Name="OutputLog"/>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
          </ad:LayoutPanel>

        </ad:LayoutPanel>
      </ad:LayoutRoot>
    </ad:DockingManager>

  </DockPanel>
</Window>
