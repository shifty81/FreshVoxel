<UserControl x:Class="FreshEditor.WPF.Controls.ContentBrowserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1E1E1E">
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="4,2">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="⟳" Padding="6,1" ToolTip="Refresh"
                Background="#FF3F3F46" Foreground="White" BorderBrush="#FF555558"
                Click="RefreshButton_Click"/>
        <TextBlock Text="Content Browser" FontWeight="Bold" Foreground="#FFD4D4D4"
                   VerticalAlignment="Center"/>
      </DockPanel>
    </Border>

    <!-- Path / breadcrumb -->
    <TextBlock x:Name="CurrentPathLabel" DockPanel.Dock="Top"
               Foreground="#FF888888" FontSize="10" Margin="4,2,4,0"
               Text="(no project open)"/>

    <!-- Left: directory tree / Right: file grid -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Folder tree -->
      <TreeView x:Name="FolderTree" Grid.Column="0"
                Background="#FF252526" Foreground="#FFD4D4D4" BorderBrush="Transparent"
                SelectedItemChanged="FolderTree_SelectedItemChanged"/>

      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                    Background="#FF3F3F46"/>

      <!-- File list -->
      <ListBox x:Name="FileList" Grid.Column="2"
               Background="#FF1E1E1E" Foreground="#FFD4D4D4" BorderBrush="Transparent"
               SelectionMode="Single"
               MouseDoubleClick="FileList_DoubleClick"
               AllowDrop="True" Drop="FileList_Drop">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="2">
              <TextBlock Text="{Binding Icon}" FontSize="18" Margin="0,0,4,0"/>
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="11"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
