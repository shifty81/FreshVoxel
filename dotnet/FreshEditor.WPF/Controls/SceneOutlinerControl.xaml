<UserControl x:Class="FreshEditor.WPF.Controls.SceneOutlinerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1E1E1E" Foreground="White">
  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="#FF2D2D30" Padding="4,2">
      <TextBlock Text="Scene Outliner" FontWeight="Bold" Foreground="#FFD4D4D4"/>
    </Border>

    <!-- Search box -->
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top"
             Background="#FF252526" Foreground="White"
             BorderBrush="#FF3F3F46" Margin="4,4,4,2"
             Text="" TextChanged="SearchBox_TextChanged"
             ToolTip="Filter entities"/>

    <!-- Entity tree -->
    <TreeView x:Name="EntityTree" Background="#FF1E1E1E" Foreground="#FFD4D4D4"
              BorderBrush="Transparent"
              SelectedItemChanged="EntityTree_SelectedItemChanged">
      <TreeView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Save as Prefab…" Click="SaveAsPrefab_Click"/>
        </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem">
          <Setter Property="Foreground" Value="#FFD4D4D4"/>
          <Setter Property="Background" Value="Transparent"/>
          <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Background" Value="#FF0078D7"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#FF3E3E42"/>
            </Trigger>
          </Style.Triggers>
        </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
        <HierarchicalDataTemplate ItemsSource="{Binding Components}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="📦 " FontSize="11"/>
            <TextBlock Text="{Binding Name}" FontSize="12"/>
            <TextBlock Text=" [" FontSize="10" Foreground="#FF888888"/>
            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#FF888888"/>
            <TextBlock Text="]" FontSize="10" Foreground="#FF888888"/>
          </StackPanel>
        </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
